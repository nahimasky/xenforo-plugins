  <phrase title="sbr_unassign" version_id="1000000" version_string="1.0.0"><![CDATA[Снять]]></phrase>
  <phrase title="sbr_nobody_has_this_badge" version_id="1000000" version_string="1.0.0"><![CDATA[Плашка пока никому не выдана.]]></phrase>
