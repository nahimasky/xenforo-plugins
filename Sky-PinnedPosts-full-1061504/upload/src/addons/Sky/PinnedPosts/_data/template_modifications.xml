<?xml version="1.0" encoding="utf-8"?>
<template_modifications>
  <modification type="public" template="post_macros" modification_key="sky_pinnedposts_post_macros" description="Sky/PinnedPosts: адаптивное действие закрепления в панели сообщения" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<xf:set var="$hasActionBarMenu" value="{{ false }}" />]]></find>
    <replace><![CDATA[$0
                <xf:if is="$thread.isPostPinned($post.post_id) AND $thread.canUnpinPost($post)">
                        <a href="{{ link('threads/unpin-post', $thread, {'post_id': $post.post_id}) }}"
                            data-xf-click="overlay"
                            class="actionBar-action actionBar-action--unpin actionBar-action--menuItem">
                            <xf:fa icon="fa-thumbtack" /> {{ phrase('sky_pinnedposts.unpin') }}
                        </a>
                <xf:elseif is="$thread.canPinPost($post)" />
                        <a href="{{ link('threads/pin-post', $thread, {'post_id': $post.post_id}) }}"
                            data-xf-click="overlay"
                            class="actionBar-action actionBar-action--pin actionBar-action--menuItem">
                            <xf:fa icon="fa-thumbtack" /> {{ phrase('sky_pinnedposts.pin') }}
                        </a>
                </xf:if>
                <xf:if is="($thread.isPostPinned($post.post_id) AND $thread.canUnpinPost($post)) OR $thread.canPinPost($post)">
                    <xf:set var="$hasActionBarMenu" value="{{ true }}" />
                </xf:if>]]></replace>
  </modification>
  <modification type="public" template="post_macros" modification_key="sky_pinnedposts_post_top_marker" description="Sky/PinnedPosts: верхняя метка закреплённого сообщения" execution_order="5" enabled="1" action="str_replace">
    <find><![CDATA[<div class="message-main js-quickEditTarget">]]></find>
    <replace><![CDATA[$0
                        <xf:if is="$thread.isPostPinned($post.post_id) AND $thread.canShowPinnedPostMarker()">
                            <div class="sky-pinnedPost-topMarker">
                                <xf:fa icon="fa-thumbtack" />
                                <span>{{ phrase('sky_pinnedposts.pinned_marker') }}</span>
                            </div>
                        </xf:if>]]></replace>
  </modification>
  <modification type="public" template="post_macros" modification_key="sky_pinnedposts_post_top_marker_uix" description="Sky/PinnedPosts: верхняя метка закреплённого сообщения в UI.X" execution_order="5" enabled="1" action="str_replace">
    <find><![CDATA[<div class="message-main uix_messageContent js-quickEditTarget">]]></find>
    <replace><![CDATA[$0
                                <xf:if is="$thread.isPostPinned($post.post_id) AND $thread.canShowPinnedPostMarker()">
                                    <div class="sky-pinnedPost-topMarker">
                                        <xf:fa icon="fa-thumbtack" />
                                        <span>{{ phrase('sky_pinnedposts.pinned_marker') }}</span>
                                    </div>
                                </xf:if>]]></replace>
  </modification>
  <modification type="public" template="sky_pinnedposts_pin_confirm" modification_key="sky_pinnedposts_pin_confirm_label_compat" description="Sky/PinnedPosts: метка в старом UI.X pin confirm override" execution_order="5" enabled="1" action="str_replace">
    <find><![CDATA[Сообщение появится в блоке закреплённых сообщений вверху темы (максимум 3 закреплённых поста на тему).]]></find>
    <replace><![CDATA[Сообщение появится в блоке закреплённых сообщений вверху темы (максимум 3 закреплённых поста на тему).
            <xf:textboxrow name="pin_label" maxlength="{$thread.getPinnedPostsLabelLength()}" label="{{ phrase('sky_pinnedposts.pin_label') }}" explain="{{ phrase('sky_pinnedposts.pin_label_explain') }}" />]]></replace>
  </modification>
  <modification type="public" template="sky_pinnedposts_unpin_confirm" modification_key="sky_pinnedposts_unpin_confirm_post_id_compat" description="Sky/PinnedPosts: совместимость старых style override unpin confirm" execution_order="5" enabled="1" action="str_replace">
    <find><![CDATA[<xf:hiddenval name="post_id">{$post_id}</xf:hiddenval>]]></find>
    <replace><![CDATA[<xf:hiddenval name="post_id">{$post.post_id}</xf:hiddenval>]]></replace>
  </modification>
  <modification type="public" template="thread_view" modification_key="sky_pinnedposts_thread_view" description="Sky/PinnedPosts: вывод блока закреплённых сообщений перед лентой" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<xf:foreach loop="$posts" value="$post">]]></find>
    <replace><![CDATA[<xf:css src="sky_pinnedposts.less" />
<xf:include template="sky_pinnedposts_list" />
$0]]></replace>
  </modification>
</template_modifications>
